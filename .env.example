# Eventbrite API Configuration

# Required: Your Eventbrite API token (OAuth token)
# Get it from: https://www.eventbrite.com/platform/
# Or use the OAuth flow with the credentials below
EVENTBRITE_API_TOKEN=your_eventbrite_api_token_here

# Optional: Eventbrite API URL (default: https://www.eventbriteapi.com/v3)
# EVENTBRITE_API_URL=https://www.eventbriteapi.com/v3

# Optional: Request timeout in milliseconds (default: 30000)
# EVENTBRITE_TIMEOUT=30000

# Optional: Number of retry attempts for failed requests (default: 3)
# EVENTBRITE_RETRIES=3

# OAuth Configuration (for automated token generation)
# Required if using the OAuth flow (npm run oauth)
# Get these from your Eventbrite app at: https://www.eventbrite.com/account-settings/apps
EVENTBRITE_CLIENT_ID=your_client_id_here
EVENTBRITE_CLIENT_SECRET=your_client_secret_here

# Optional: OAuth redirect URI (default: http://localhost:3000/oauth/eventbrite/callback)
# This must match the redirect URI configured in your Eventbrite app
# EVENTBRITE_REDIRECT_URI=http://localhost:3000/oauth/eventbrite/callback

# Optional: OAuth server port (default: 3000)
# OAUTH_PORT=3000
